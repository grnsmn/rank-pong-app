# ============================================================
# RankPong — Environment Variables
# ============================================================
#   .env.development → Supabase LOCALE (usato da `npm run dev`)
#                      URL e chiave si leggono con `supabase status`
#   .env.production  → progetto Supabase PROD (usato da `npm run build`)
#   .env             → lasciarlo VUOTO: Vite lo carica in ogni modalità,
#                      credenziali PROD qui finirebbero anche in sviluppo
#
# NON committare mai i file .env.*
# Su Netlify configura le variabili direttamente nella dashboard.
# ============================================================

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
